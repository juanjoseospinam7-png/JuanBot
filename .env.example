# Copia este archivo a .env y ajusta los valores.

# Prefijo estricto de comandos
PREFIX=..

# Número del propietario sin "+" ni espacios (ej: 573052882471)
OWNER_NUMBER=
# Opcional: LID del propietario si WhatsApp lo usa en tu cuenta (ej: 123456789@lid)
OWNER_LID=

BOT_NAME=JUAN-BOT

# Carpeta de sesión de Baileys (contiene claves privadas, no compartir)
AUTH_DIR=auth_info_baileys

# true = vinculación por código de 8 dígitos en vez de QR
USE_PAIRING_CODE=false

# debug | info | warn | error
LOG_LEVEL=info

# Metadatos de stickers
STICKER_PACK=JUAN-BOT
STICKER_AUTHOR=JUANOSPINA

# Descargas (YouTube/TikTok/etc. mediante yt-dlp)
MAX_DOWNLOAD_MB=64
DOWNLOAD_TIMEOUT_MS=180000
# Ruta opcional a cookies.txt exportadas de YouTube para evitar bloqueos
YTDLP_COOKIES=

# Milisegundos entre usos del mismo comando por usuario
DEFAULT_COOLDOWN_MS=2500

# Ignorar mensajes más viejos que esto (evita responder historial)
SESSION_MAX_AGE_MS=180000

TZ=America/Bogota
NSFW_ENABLED=false
